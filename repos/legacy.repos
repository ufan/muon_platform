# Managed legacy references (ADR-009 §5, §15; ADR-012). Read-only: `muon ws sync --legacy` clones
# them and applies the L1 lock (read-only tree, push disabled, refusing hooks). Never edit or build
# inside them; build out of tree (`muon legacy build-dir <name>`).
repositories:
  legacy/muon400_process:
    type: git
    url: git@gitee.com:chinamyworld/muon400_process.git
    version: deploy
    muon: {maturity: legacy, submodules: true, informs: [core], role: "legacy MUON400 chain (fx3 readout, unpack/decode, hit, track)", spec: platform/docs/legacy_inventory.md}
  legacy/analysis:
    type: git
    url: git@gitee.com:chinamyworld/muon_analysis.git
    version: main
    muon: {maturity: legacy, informs: [core], role: "legacy ROOT macros, notebooks and baseline studies", spec: platform/docs/legacy_inventory.md}
  legacy/usb_app2:
    type: git
    url: git@github.com:jw-1404/usb_app2.git
    version: daemon-dev
    muon: {maturity: legacy, informs: [core], role: "prototype DAQ software tested on the current hardware (deploy = field branch)", spec: core/daq/doc/guides/prototype-reference.md}
